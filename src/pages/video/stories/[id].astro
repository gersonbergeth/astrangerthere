---
import MainLayout from "../../../layouts/MainLayout.astro";
import { stories } from "../../../data/stories.js";

export function getStaticPaths() {
  return stories.map((story) => ({
    params: { id: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
---

<MainLayout title={story.title}>
  <main class="story-viewer">

    <video
      id="story-video"
      class="story-video"
      playsinline
      preload="metadata"
    >
      <source src={story.video} type="video/mp4" />
    </video>


    <!-- VIDEO PROGRESS — TOP LEFT -->
    <div class="video-progress" role="progressbar" aria-label="Video playback progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div id="video-progress-fill" class="video-progress-fill"></div>
    </div>


    <!-- NAVIGATION — TOP RIGHT -->
    <nav class="viewer-nav" aria-label="Site navigation">
      <a class="nav-circle" href="/video/stories" aria-label="Stories"></a>
      <a class="nav-circle" href="/video" aria-label="Video"></a>
      <a class="nav-circle" href="/" aria-label="Home"></a>
    </nav>


    <!-- EXPLANATION — BOTTOM LEFT -->
    <button
      id="explanation-button"
      class="explanation-button"
      type="button"
      aria-label="Show explanation"
    >
      +
    </button>

    <div
      id="explanation-panel"
      class="explanation-panel"
      aria-hidden="true"
    >
      <p>{story.description ?? "Explanation for this story will go here."}</p>
    </div>


    <!-- PLAY / PAUSE — BOTTOM RIGHT -->
    <button
      id="play-button"
      class="play-button"
      type="button"
      aria-label="Play video"
    >
      <span class="play-icon"></span>
      <span class="pause-icon"></span>
    </button>

  </main>
</MainLayout>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: black;
  }

  .story-viewer {
    position: relative;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    background: black;
  }

  .story-video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    background: black;
    cursor: pointer;
  }


  /* VIDEO PROGRESS */

  .video-progress {
    position: fixed;
    top: clamp(1.5rem, 3vw, 2rem);
    left: clamp(1.5rem, 3vw, 2rem);
    z-index: 20;
    width: 113px;
    height: 19px;
    border: 1px solid white;
    box-sizing: border-box;
    padding: 2px;
    pointer-events: none;
  }

  .video-progress-fill {
    width: 0%;
    height: 100%;
    background: white;
  }


  /* NAVIGATION */

  .viewer-nav {
    position: fixed;
    top: clamp(1.5rem, 3vw, 2rem);
    right: clamp(1.5rem, 3vw, 2rem);
    z-index: 40;
    display: flex;
    gap: 12px;
  }

  .nav-circle {
    display: block;
    width: clamp(18px, 1.4vw, 20px);
    height: clamp(18px, 1.4vw, 20px);
    border-radius: 50%;
    background: white;
  }


  /* EXPLANATION BUTTON — LOCKED BOTTOM LEFT */

  .explanation-button {
    position: fixed;
    left: clamp(1.5rem, 3vw, 2rem);
    right: auto;
    bottom: clamp(1.5rem, 3vw, 2rem);

    z-index: 50;

    appearance: none;
    -webkit-appearance: none;

    width: auto;
    height: auto;

    margin: 0;
    padding: 0;

    border: 0;
    border-radius: 0;

    background: transparent;
    color: white;

    font-family: "Courier New", monospace;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1;

    transform: none;

    cursor: pointer;
  }

  .explanation-button:focus,
  .explanation-button:active {
    background: transparent;
    color: white;
    outline: none;
  }


  /* EXPLANATION PANEL */

  .explanation-panel {
    position: fixed;
    left: 0;
    bottom: 4.5rem;
    z-index: 45;

    width: min(620px, calc(100vw - 3rem));
    padding: 1.5rem 2rem;

    box-sizing: border-box;

    color: white;
    background: rgb(0 0 0 / 78%);

    transform: translateX(-105%);
    transition: transform 0.4s ease;

    pointer-events: none;
  }

  .explanation-panel.visible {
    transform: translateX(0);
    pointer-events: auto;
  }

  .explanation-panel p {
    margin: 0;
    font-family: "Courier New", monospace;
    font-size: clamp(0.85rem, 1.2vw, 1rem);
    line-height: 1.6;
  }


  /* PLAY BUTTON — LOCKED BOTTOM RIGHT */

  .play-button {
    position: fixed;
    right: clamp(1.5rem, 3vw, 2rem);
    left: auto;
    bottom: clamp(1.5rem, 3vw, 2rem);

    z-index: 50;

    appearance: none;
    -webkit-appearance: none;

    width: 34px;
    height: 34px;

    margin: 0;
    padding: 0;

    border: 0;
    border-radius: 0;

    background: transparent;

    display: grid;
    place-items: center;

    transform: none;

    cursor: pointer;
  }

  .play-button:focus,
  .play-button:active {
    background: transparent;
    outline: none;
  }


  /* PLAY TRIANGLE */

  .play-icon {
    display: block;

    width: 0;
    height: 0;

    border-top: 12px solid transparent;
    border-bottom: 12px solid transparent;
    border-left: 19px solid white;

    margin-left: 4px;
  }


  /* PAUSE — TWO WHITE CSS BARS */

  .pause-icon {
    display: none;

    width: 18px;
    height: 24px;

    border-left: 6px solid white;
    border-right: 6px solid white;

    box-sizing: border-box;
  }

  .play-button.playing .play-icon {
    display: none;
  }

  .play-button.playing .pause-icon {
    display: block;
  }


  /* MOBILE */

  @media (max-width: 768px) {

    .video-progress {
      width: 95px;
      height: 15px;
    }

    .explanation-panel {
      bottom: 4rem;
      width: calc(100vw - 2rem);
      padding: 1.25rem 1.5rem;
    }

  }
</style>

<script>
  const video = document.querySelector("#story-video");
  const play = document.querySelector("#play-button");

  const explanationButton =
    document.querySelector("#explanation-button");

  const explanationPanel =
    document.querySelector("#explanation-panel");


  /* PLAY / PAUSE */

  async function togglePlayback() {
    if (!(video instanceof HTMLVideoElement)) return;

    if (video.paused) {
      try {
        await video.play();
      } catch {}
    } else {
      video.pause();
    }
  }

  function updatePlay() {
    if (
      video instanceof HTMLVideoElement &&
      play instanceof HTMLButtonElement
    ) {
      const playing = !video.paused;

      play.classList.toggle("playing", playing);

      play.setAttribute(
        "aria-label",
        playing ? "Pause video" : "Play video"
      );
    }
  }


  /* EXPLANATION */

  explanationButton?.addEventListener("click", () => {
    if (
      !(explanationButton instanceof HTMLButtonElement) ||
      !(explanationPanel instanceof HTMLElement)
    ) return;

    const open =
      explanationPanel.classList.toggle("visible");

    explanationButton.textContent =
      open ? "−" : "+";

    explanationPanel.setAttribute(
      "aria-hidden",
      open ? "false" : "true"
    );
  });


  /* VIDEO PROGRESS */

  function updateProgress() {
    if (!(video instanceof HTMLVideoElement)) return;

    const fill = document.querySelector("#video-progress-fill");
    const bar = document.querySelector(".video-progress");
    const duration = video.duration;
    const progress = Number.isFinite(duration) && duration > 0
      ? Math.min(100, Math.max(0, (video.currentTime / duration) * 100))
      : 0;

    if (fill instanceof HTMLElement) {
      fill.style.width = `${progress}%`;
    }
    if (bar instanceof HTMLElement) {
      bar.setAttribute("aria-valuenow", String(Math.round(progress)));
    }
  }


  /* EVENTS */

  play?.addEventListener("click", togglePlayback);
  video?.addEventListener("click", togglePlayback);

  video?.addEventListener("play", updatePlay);
  video?.addEventListener("pause", updatePlay);
  video?.addEventListener("ended", updatePlay);

  video?.addEventListener("timeupdate", updateProgress);
  video?.addEventListener("seeked", updateProgress);
  video?.addEventListener("loadedmetadata", updateProgress);

  updatePlay();
  updateProgress();
</script>