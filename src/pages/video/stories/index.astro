---
import MainLayout from "../../../layouts/MainLayout.astro";
import { stories } from "../../../data/stories.js";
---

<MainLayout title="Stories in 2 Minutes or Less">
  <main class="stories-page">

    <nav class="stories-nav" aria-label="Site navigation">
      <a class="nav-circle" href="/video" aria-label="Video"></a>
      <a class="nav-circle" href="/" aria-label="Home"></a>
    </nav>

    <section class="stories-grid" aria-label="Stories in 2 Minutes or Less">
      {stories.map((story) => (
        <a
          class="story-card"
          href={`/video/stories/${story.id}`}
          aria-label={`Open ${story.title}`}
        >
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
          >
            <source src={story.video} type="video/mp4" />
          </video>

        </a>
      ))}
    </section>

  </main>
</MainLayout>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: black;
  }

  .stories-page {
    position: relative;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    background: black;
  }

  .stories-grid {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 4px;
    padding: 4px;
    box-sizing: border-box;
  }

  .story-card {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    display: block;
    background: black;
  }

  .story-card video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .stories-nav {
    position: fixed;
    top: 2rem;
    right: 2rem;
    z-index: 20;
    display: flex;
    gap: 12px;
  }

  .nav-circle {
    display: block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: white;
  }

  @media (max-width: 768px) {
    .stories-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(4, 1fr);
    }

    .stories-nav {
      top: 1.5rem;
      right: 1.5rem;
    }

    .nav-circle {
      width: 18px;
      height: 18px;
    }

  }
</style>