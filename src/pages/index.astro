---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Home">

<section class="hero">

    <video autoplay muted loop playsinline class="hero-video">
        <source src="/videos/home-background.mp4" type="video/mp4" />
    </video>

    <div class="overlay"></div>

    <div class="hero-content">

        <h1>A Stranger There</h1>

        <nav class="hero-menu">
            <a href="/photo">Photo</a>
            <a href="/video">Video</a>
            <a href="/art">Art</a>
            <a href="/words">Words</a>
            <span class="coming-soon">Products</span>

            <a href="/music">
                <span class="crossed-out">Music</span> Lyrics
            </a>

            <span class="coming-soon">Memo</span>
        </nav>

        <div class="typewriter" aria-live="polite">
            <p id="typed-text"></p>
            <span class="cursor">|</span>
        </div>

    </div>

</section>

<script is:inline>
const welcome = `We are all strangers somewhere. Some places become home. Others remain memories. We are all strangers somewhere. We are all strangers somewhere. Some places become home. Others remain memories. We are all strangers somewhere. We are all strangers somewhere. Some places become home. Others remain memories. We are all strangers somewhere.`;

const variants = [

`It was given to me unawares
Handed to me as a gift, a reward
Baptized into the name I became
Task completed, a person launched
For perpetuity this was now my frame

But they did not know a stranger here
He came and stayed and left here
And it happened again and again there and here (1/7)`,

`Blinking, thinking and evaluating
Me was one of undeniable complexity
Home was not a place, earth was it
Every bed was comfortable and secure
Sustenance my large, hungry mouth bit

But they did not know a stranger here
He came and stayed and left here
And it happened again and again there and here (2/7)`,

`My story was not meant for everyone
Untethered is not a warm cup of tea
All who wonder are seeking a place
Lost on purpose is very hard work
Better to oscillate than live in a fixed space

But they did not know a stranger here
He came and stayed and left here
And it happened again and again there and here (3/7)`,

`A name and a prophesy to this child
The divine intervention of some large god
Did destiny decide or did I build destiny?
It does not matter, really, because life happens
As the end draws near I do over again happily

But they did not know a stranger here
He came and stayed and left here
And it happened again and again there and here (4/7)`,

`Anchor-less and listless, animated everyday
Challenge is routine and mystery understood
The agenda is full to the brim of brims
Time, is not sufficient at all, for sure
The voice sings loudly unholy hymns

But they did not know a stranger here
He came and stayed and left here
And it happened again and again there and here (5/7)`,

`Gallop is my mind to the minute
Wound up but not bound up
Floating high above the brown sea
Check in, will you? I still miss you
Chase as much as you like, my body will flee

But they did not know a stranger here
He came and stayed and left here
And it happened again and again there and here (6/7)`,

`A resting place I will devour
I know not the time or the hour
Death that shows itself often darkly
Life that threatens to cut me shortly
Every person beams and flowers, rest not

But they did not know a stranger here
He came and stayed and left here
And it happened again and again there and here (7/7)`

];

const visits = Number(localStorage.getItem("homeVisits") || 0);

let text;

if (visits === 0) {
    text = welcome;
} else if (visits <= 7) {
    text = variants[visits - 1];
} else {
    text = variants[Math.floor(Math.random() * variants.length)];
}

localStorage.setItem("homeVisits", String(visits + 1));

const target = document.getElementById("typed-text");

let i = 0;

function type() {
    if (!target || i >= text.length) return;

    target.textContent += text.charAt(i);
    i++;

    setTimeout(type, 60);
}

type();
</script>

</MainLayout>

<style>

.hero {
    position: relative;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
}

.hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.25);
}

.hero-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-left: 8%;
    color: white;
}

.hero-menu {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 2rem;
}

.hero-menu a {
    color: white;
    text-decoration: none;
    font-size: 1.3rem;
    transition: opacity .2s;
}

.hero-menu .coming-soon {
    color: white;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    text-decoration-color: white;
    opacity: 0.65;
    cursor: default;
}

.hero-menu a:hover {
    opacity: .7;
}

.hero-content h1 {
    color: white;
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 300;
}

.typewriter {
    position: absolute;
    top: 25%;
    right: 8%;
    width: min(500px, 40%);
    color: white;
    font-family: "Courier New", monospace;
    font-size: 1.1rem;
    line-height: 1.7;
}

.typewriter p {
    margin: 0;
    white-space: pre-line;
}

.cursor {
    animation: blink .8s infinite;
}

.crossed-out {
    text-decoration: line-through;
}

@keyframes blink {
    50% {
        opacity: 0;
    }
}

@media (max-width: 768px) {

    .hero-content {
        position: relative;
        height: 100%;
        padding: 0;
    }

    .hero-menu {
        position: absolute;
        top: 5vh;
        right: 8%;
        align-items: flex-end;
        text-align: right;
        margin: 0;
    }

    .hero-content h1 {
        position: absolute;
        top: 36%;
        left: 8%;
        right: 8%;
        margin: 0;
        font-size: 2.4rem;
        text-align: left;
    }

    .typewriter {
        top: 62%;
        left: 8%;
        right: 8%;
        width: auto;
        font-size: 0.9rem;
        line-height: 1.5;
    }

}


/* Prevent title and typewriter overlap on laptops and desktops */
@media (min-width: 769px) {

    .hero-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        column-gap: 4rem;
        align-content: center;
        align-items: center;
        padding: 0 8%;
        box-sizing: border-box;
    }

    .hero-content h1 {
        grid-column: 1;
        grid-row: 1;
        font-size: clamp(3rem, 5vw, 6rem);
        max-width: 100%;
        margin: 0;
        overflow-wrap: break-word;
    }

    .hero-menu {
        grid-column: 1;
        grid-row: 2;
    }

    .typewriter {
        position: relative;
        grid-column: 2;
        grid-row: 1 / 3;
        top: auto;
        right: auto;
        left: auto;
        width: 100%;
        min-width: 0;
        align-self: center;
        font-size: clamp(0.85rem, 1.15vw, 1.1rem);
        overflow-wrap: anywhere;
    }
}

</style>