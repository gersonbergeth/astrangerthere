---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Music">
  <main class="music-page">

    <video autoplay muted loop playsinline class="background-video">
      <source src="/videos/music/music-background.mp4" type="video/mp4" />
    </video>

    <div class="overlay"></div>

    <a href="/" class="home-circle" aria-label="Return home"></a>

    <h1>But there is no sound!</h1>

    <a
      class="record-player-hotspot"
      href="/music/lyrics"
      aria-label="Open lyrics"
    ></a>

  </main>
</MainLayout>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: black;
  }

  .music-page {
    position: relative;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    color: white;
  }

  .background-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(0 0 0 / 25%);
    pointer-events: none;
  }

  h1 {
    position: absolute;
    left: 3rem;
    top: 50%;
    z-index: 3;
    margin: 0;
    max-width: 10ch;
    transform: translateY(-50%);
    font-size: clamp(2rem, 4vw, 5rem);
    line-height: 0.95;
    font-weight: 300;
    pointer-events: none;
  }

  .home-circle {
    position: fixed;
    top: 2rem;
    right: 2rem;
    z-index: 20;
    width: 20px;
    height: 20px;
    display: block;
    border-radius: 50%;
    background: white;
  }

  .record-player-hotspot {
    position: absolute;
    z-index: 10;

    left: 45%;
    top: 45%;
    width: 52%;
    height: 52%;

    display: block;
    background: transparent;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    h1 {
      left: 1.5rem;
      top: 42%;
      font-size: 2.4rem;
    }

    .home-circle {
      top: 1.5rem;
      right: 1.5rem;
      width: 18px;
      height: 18px;
    }

    .record-player-hotspot {
      left: 35%;
      top: 48%;
      width: 65%;
      height: 50%;
    }
  }
</style>